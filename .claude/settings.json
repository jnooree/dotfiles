{
  "cleanupPeriodDays": 365,
  "permissions": {
    "allow": [
      "WebSearch",
      "Read(//tmp/**)",
      "Bash(tmux rename-session:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/settings-heal.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/todo-commit-gate.sh"
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/plan-tmux-gate.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/plan-tmux-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-title.sh"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-create.sh"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-remove.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "github@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "understand-anything@understand-anything": true,
    "mattpocock-skills@claude-plugins-official": true,
    "pstack@cursor-plugins": true,
    "cowork-plugin-management@synced": false
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      },
      "autoUpdate": true
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Egonex-AI/Understand-Anything"
      },
      "autoUpdate": true
    },
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "theme": "auto",
  "preferredNotifChannel": "iterm2",
  "switchModelsOnFlag": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
