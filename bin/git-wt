#!/usr/bin/env bash

set -euo pipefail

hint() {
	local color='' reset='' tty=false line
	[[ -t 2 ]] && tty=true
	if [[ $(git config --get-colorbool color.advice "$tty") == true ]]; then
		color=$(git config --get-color color.advice.hint yellow)
		reset=$(git config --get-color '' reset)
	fi
	while IFS= read -r line; do
		printf '%shint: %s%s\n' "$color" "$line" "$reset"
	done
}

fatal() {
	echo "fatal: $1"
}

usage() {
	git wt -h
	exit 2
}

die() {
	fatal "$1"
	exit 1
}

known_branch() {
	git show-ref --verify -q "refs/heads/$1" ||
		[[ -n $(git for-each-ref --count=1 "refs/remotes/*/$1") ]]
}

orca_json() {
	REPLY=$(orca "$@" --json) ||
		die "orca $1 $2: $(jq -r '.error.message' <<<"$REPLY")"
}

create_orca() {
	local branch=$1 base=$2 follow=$3 got
	local -a F

	if [[ -n $follow ]]; then
		git show-ref --verify -q "refs/heads/$branch" ||
			git branch --track -- "$branch" \
				"$(git for-each-ref --format='%(refname:short)' "refs/remotes/*/$branch")"
		base=$branch
	else
		base=$(git rev-parse --verify "${base:-HEAD}^{commit}")
	fi

	orca_json repo add --path "$top"
	orca_json worktree create --repo "path:$top" --name "${dir##*/}" \
		--no-parent --branch "$branch" --base-branch "$base"
	mapfile -d '' -t F < <(jq --raw-output0 '.result.worktree | .path, .branch' <<<"$REPLY")
	dir="${F[0]}" got="${F[1]}"

	# XXX: orca exits 0 after silently suffixing a branch it cannot check out.
	if [[ $got != "refs/heads/$branch" ]]; then
		orca_json worktree rm --worktree "path:$dir"
		git branch -D -- "${got#refs/heads/}"
		die "branch '$branch' or its worktree path is taken (orca created '${got#refs/heads/}')"
	fi
	orca_json worktree set --worktree "path:$dir" --display-name "$branch"
}

create() {
	local branch=$1 base=$2 suffix follow=''
	suffix=${branch#*/}
	suffix=${suffix//[-\/]/_}
	dir=${top}-wt-$(date +%y%m%d)-${suffix}

	if [[ -z $base ]] && known_branch "$branch"; then
		follow=1
	fi

	if [[ -n $orca ]]; then
		create_orca "$branch" "$base" "$follow"
		return
	fi

	mkdir "$dir" 2>/dev/null || die "worktree path already exists: $dir"

	trap 'rmdir "$dir" 2>/dev/null' ERR
	if [[ -n $follow ]]; then
		git worktree add -- "$dir" "$branch"
	else
		git worktree add -b "$branch" -- "$dir" "${base:-HEAD}"
	fi
}

hint_denied() {
	local dir=$1 range=$2 shown=10 hidden
	hidden=$(($(git -C "$top" rev-list --count "$range") - shown))
	{
		git -C "$top" log --oneline -n "$shown" "$range"
		((hidden <= 0)) || echo "... and $hidden more"
		git -C "$dir" status -sb
		echo "use -f/-ff to delete it anyway"
	} | hint
}

delete() {
	local dir=$1 branch ref rc
	local -a remove_opts=() branch_opts=(-d)

	dir=$(realpath -- "$dir")
	[[ $dir != "$top" ]] || die "refusing to remove the main worktree: $dir"
	branch=$(git -C "$dir" symbolic-ref --short -q HEAD) ||
		die "detached HEAD at $dir; use git worktree remove"

	ref="$branch@{upstream}"
	git -C "$top" rev-parse -q --verify "$ref" >/dev/null || ref=HEAD
	if ((force >= 1)); then
		branch_opts=(-D)
	elif ! git -C "$top" merge-base --is-ancestor "$branch" "$ref"; then
		fatal "branch '$branch' is not merged into $(git -C "$top" rev-parse --abbrev-ref "$ref")"
		hint_denied "$dir" "$ref..$branch"
		exit 1
	fi
	((force >= 2)) && remove_opts=(--force)

	git -C "$top" worktree remove "${remove_opts[@]}" -- "$dir" || {
		rc=$?
		((force >= 2)) || hint_denied "$dir" "$ref..$branch"
		exit $rc
	}
	git -C "$top" branch "${branch_opts[@]}" -- "$branch" || {
		rc=$?
		hint <<<"worktree removed; delete the branch with: git branch -D $branch"
		exit $rc
	}
}

main() {
	spec="\
git wt [-b <base>] [-o] <branch>
git wt -d [-f|-ff] <path>
--
b,base=!base  start point (default <branch> if it exists, else HEAD)
o,orca!       create through Orca, registering the repo if needed
d,delete!     remove the worktree at <path> and delete its branch
f,force!      once: delete an unmerged branch; twice: also remove a dirty tree
"
	eval "$(echo "$spec" | git rev-parse --parseopt -- "$@" || echo exit $?)"

	base='' delete='' orca='' force=0
	while [[ $1 != -- ]]; do
		case $1 in
		-b | --base)
			base=$2
			shift
			;;
		-o | --orca) orca=1 ;;
		-d | --delete) delete=1 ;;
		-f | --force) force=$((force + 1)) ;;
		esac
		shift
	done
	shift
	[[ $# == 1 ]] || usage

	top=$(git rev-parse --path-format=absolute --git-common-dir)
	top=${top%/.git}

	if [[ -z $delete ]]; then
		((force == 0)) || usage
		create "$1" "$base"
		REPLY=$dir
	else
		[[ -z $base && -z $orca ]] || usage
		delete "$1"
		REPLY=$top
	fi
}

# Stdout carries only the resulting path, because:
#   - for create, the Claude WorktreeCreate hook reads it, and
#   - for both, makes cd "$(git wt ...)" convenient.
main "$@" >&2
echo "$REPLY"
