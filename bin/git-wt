#!/usr/bin/env bash

set -euo pipefail

spec="\
git wt [-b <base>] <branch>
--
b,base=!base	start point (default HEAD)
"
eval "$(echo "$spec" | git rev-parse --parseopt -- "$@" || echo exit $?)"

base=HEAD
while [[ $1 != -- ]]; do
	case $1 in
	-b | --base)
		base=$2
		shift
		;;
	esac
	shift
done
shift
if [[ $# != 1 || -z $base ]]; then
	git wt -h >&2
	exit 2
fi

branch=$1

top=$(git rev-parse --path-format=absolute --git-common-dir)
top=${top%/.git}
suffix=${branch#*/}
suffix=${suffix//[-\/]/_}
dir=${top}-wt-$(date +%y%m%d)-${suffix}

if ! mkdir "$dir" 2>/dev/null; then
	echo "worktree path already exists: $dir" >&2
	exit 1
fi

trap 'rmdir "$dir" 2>/dev/null' ERR
git worktree add -b "$branch" -- "$dir" "$base" >&2
echo "$dir"
