# shellcheck disable=all

unfunction mamba 2>/dev/null

export MAMBA_EXE="$HOME/anaconda3/bin/mamba"
export MAMBA_ROOT_PREFIX="$HOME/anaconda3"

local __mamba_setup
__mamba_setup="$(
	"$MAMBA_EXE" shell hook --shell zsh --root-prefix "$MAMBA_ROOT_PREFIX" 2>/dev/null
)"
if [[ $? -eq 0 ]]; then
	eval "$__mamba_setup"
else
	function mamba() {
		"$MAMBA_EXE" "$@"
	}
fi

mamba "$@"
